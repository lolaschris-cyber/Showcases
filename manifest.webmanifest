{
 "id": "./",
 "name": "Showcase Scanner",
 "short_name": "Showcase",
 "start_url": "./",
 "scope": "./",
 "display": "standalone",
 "background_color": "#f7f7f5",
 "theme_color": "#2f6fed",
 "icons": [
  {
   "src": "icon-192.png",
   "sizes": "192x192",
   "type": "image/png"
  },
  {
   "src": "icon-512.png",
   "sizes": "512x512",
   "type": "image/png"
  },
  {
   "src": "icon-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "maskable"
  }
 ],
 "share_target": {
  "action": "./share-target",
  "method": "POST",
  "enctype": "multipart/form-data",
  "params": {
   "files": [
    {
     "name": "shots",
     "accept": [
      "image/*"
     ]
    }
   ]
  }
 }
}